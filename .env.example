# Copy this file to .env and fill it in. Never commit .env.

NODE_ENV=development
PORT=5000

# Website origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://naxatralabs.com,https://www.naxatralabs.com,https://naxatranew.vercel.app

# Set to the number of proxies in front of the server when hosted (e.g. 1 behind Render/Railway/Nginx).
# TRUST_PROXY=1

# --- SMTP (Nodemailer) ---------------------------------------------------------------
# Leave SMTP_HOST empty in development to log emails instead of sending them.
# Google Workspace: smtp.gmail.com, port 465, SMTP_SECURE=true, an App Password as SMTP_PASS.
# Mail is sent from the marketing@ mailbox (its App Password goes in SMTP_PASS, spaces removed).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=marketing@naxatralabs.com
SMTP_PASS=
# Sender shown on every email. Must be an address the SMTP account is allowed to send as.
MAIL_FROM="Naxatra Labs <marketing@naxatralabs.com>"

# Where the email images (dark header hero, logo, social icons) are hosted. Must be a public https
# URL; email clients strip SVG and reject local refs. These files live in the website repo under
# public/email-assets/, so the deployed site serves them. Use the new site's address: the Vercel URL until
# www.naxatralabs.com points at the new site, then https://www.naxatralabs.com/email-assets.
EMAIL_ASSET_BASE=https://naxatranew.vercel.app/email-assets

# --- Where each form goes (comma-separated for several people) ---------------------------
# Contact page enquiries. Optional per-topic overrides; a topic left blank uses CONTACT_TO.
CONTACT_TO=enquiry@naxatralabs.com
CONTACT_MOTORS_TO=
CONTACT_INVESTMENT_TO=
CONTACT_PARTNERSHIP_TO=
CONTACT_OTHERS_TO=
# Careers applications (with the resume attached).
CAREERS_TO=enquiry@naxatralabs.com
# "Share your specs" form on the industry, Drone and Products pages.
SPEC_ENQUIRY_TO=enquiry@naxatralabs.com
# Footer newsletter sign-ups.
NEWSLETTER_TO=enquiry@naxatralabs.com

# --- reCAPTCHA v2 secret key (newsletter) -----------------------------------------------
# The site key goes in the website's VITE_RECAPTCHA_SITE_KEY; the secret stays here only.
# Optional to start: without it the other forms work and, in production, the newsletter sign-up is off.
RECAPTCHA_SECRET=

# Submissions allowed per IP per form every 15 minutes.
RATE_LIMIT=10
